# TOEFL House ERP v3 — Production .env template
# Copy to .env on production VPS and fill real secrets
# Per 13_INFRASTRUCTURE_AND_DEPLOYMENT.md

APP_NAME="TOEFL House ERP"
APP_ENV=production
APP_KEY=base64:CHANGE_ME_AFTER_FIRST_DEPLOY
APP_DEBUG=false
APP_TIMEZONE=Asia/Kabul
APP_URL=https://your-production-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toefl_house_v3
DB_USERNAME=toefl_prod
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=your-production-domain.com

# Optional AI summary (12)
ANTHROPIC_API_KEY=

# Mail (production should use real SMTP or service)
MAIL_MAILER=smtp
MAIL_HOST=mailpit   # or real smtp
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@toeflhouse.af"
MAIL_FROM_NAME="${APP_NAME}"
